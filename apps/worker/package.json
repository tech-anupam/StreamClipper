{
  "name": "@streamclipper/worker",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "cli:auto": "tsx src/cli.ts --continuous",
    "cli:time": "tsx src/cli.ts --timestamp",
    "precli": "pnpm --filter @streamclipper/shared build",
    "precli:auto": "pnpm --filter @streamclipper/shared build",
    "precli:time": "pnpm --filter @streamclipper/shared build"
  },
  "dependencies": {
    "@streamclipper/shared": "workspace:*",
    "bullmq": "^5.30.0",
    "dotenv": "^16.4.0",
    "execa": "^9.5.0",
    "express": "^4.21.0",
    "ioredis": "^5.4.0",
    "nanoid": "^5.0.0",
    "p-queue": "^8.0.0",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
