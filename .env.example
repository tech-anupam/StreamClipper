# ── Clerk ──────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Turso (libSQL) ────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=eyJ...

# ── Google Drive ──────────────────────────────────────
# OAuth 2.0 credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Root folder name in Google Drive (created automatically)
GDRIVE_ROOT_FOLDER=StreamClipper

# ── Storage mode ──────────────────────────────────────
# "gdrive" (default) or "local" (write clips to LOCAL_CLIPS_DIR)
STORAGE_MODE=gdrive
LOCAL_CLIPS_DIR=./clips

# ── Worker ────────────────────────────────────────────
WORKER_TOKEN=generate-a-strong-random-token
WORKER_API_URL=http://localhost:8787
WORKER_PORT=9090

# ── Redis (optional, falls back to in-memory p-queue) ─
REDIS_URL=redis://localhost:6379

# ── ffmpeg / streamlink paths (auto-detected if on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
STREAMLINK_PATH=streamlink
YT_DLP_PATH=yt-dlp

# ── Limits ────────────────────────────────────────────
MAX_STREAMS_PER_USER=5
MAX_CLIP_SECONDS=120
BUFFER_SECONDS=600
BUFFER_DISK_CAP_MB=2048
CLIP_TTL_DAYS=7
RENDER_CONCURRENCY=0
